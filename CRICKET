  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@300;400;500&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { min-height: 100%; width: 100%; overflow-x: hidden; overflow-y: auto; font-family: 'Archivo', sans-serif; }

    body { background: #020202; }

    /* BG — subtle gold mesh */
    .bg {
      position: fixed; inset: 0; z-index: 0;
      background: #020202;
      background-image:
        radial-gradient(ellipse at 20% 20%, rgba(212,175,55,0.08) 0%, transparent 55%),
        radial-gradient(ellipse at 80% 80%, rgba(184,134,11,0.05) 0%, transparent 50%),
        radial-gradient(ellipse at 60% 10%, rgba(255,215,0,0.04) 0%, transparent 40%);
    }

    /* Fine hex-ish grid */
    .bg::after {
      content: ''; position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(212,175,55,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(212,175,55,0.03) 1px, transparent 1px);
      background-size: 30px 30px;
    }

    .wrapper { position: relative; z-index: 10; min-height: 100vh; display: flex; flex-direction: column; }

    /* ── TICKER ── */
    .ticker { overflow: hidden; white-space: nowrap; flex-shrink: 0; background: linear-gradient(90deg, #d4af37, #f1c40f, #d4af37); color: #000; }
    .roll { display: inline-block; animation: roll 20s linear infinite; }
    @keyframes roll { from{transform:translateX(0)} to{transform:translateX(-50%)} }

    /* SECTION 1 — profile + info row */
    .sec-1 {
      padding: 40px 24px 20px;
      display: flex;
      align-items: center;
      gap: 20px;
      position: relative;
    }

    .profile-wrap {
      position: relative;
      flex-shrink: 0;
    }
    .profile-img {
      width: clamp(80px, 25vw, 110px);
      height: clamp(80px, 25vw, 110px);
      border-radius: 50%;
      border: 2px solid #d4af37;
      padding: 3px;
      background: linear-gradient(135deg, #d4af37, #000);
      object-fit: cover;
      box-shadow: 0 10px 40px rgba(212,175,55,0.2);
    }
    .profile-badge {
      position: absolute;
      bottom: 2px;
      right: 2px;
      background: #00ff00;
      width: 14px;
      height: 14px;
      border: 2px solid #020202;
      border-radius: 50%;
    }

    .sec-1-info {
      flex: 1;
    }
    .sec-1-tag { 
      font-size: 10px; 
      letter-spacing: 0.28em; 
      text-transform: uppercase; 
      color: #d4af37;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .sec-1-name {
      font-family: 'Archivo Black', sans-serif;
      font-size: clamp(1.4rem, 6vw, 2.2rem);
      color: #fff; letter-spacing: 0.02em; line-height: 1;
      text-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }
    .sec-1-sub {
      font-size: clamp(0.7rem, 3.5vw, 0.9rem);
      color: rgba(212,175,55,0.6); letter-spacing: 0.15em;
      text-transform: uppercase; font-weight: 600;
      margin-top: 4px;
    }

    /* Gold divider line */
    .divider {
      height: 1px; margin: 0 24px;
      background: linear-gradient(90deg, rgba(212,175,55,0.5), rgba(212,175,55,0.05));
    }

    /* SECTION 2 — horizontal scrollable stat chips */
    .sec-2 { padding: 24px 24px 0; }
    .chip-scroll { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 6px; }
    .chip-scroll::-webkit-scrollbar { display: none; }
    .stat-chip {
      flex-shrink: 0;
      background: rgba(212,175,55,0.05);
      border: 1px solid rgba(212,175,55,0.2);
      border-radius: 12px; padding: 12px 16px;
      text-align: center; min-width: 80px;
      transition: background 0.2s;
    }
    .chip-val { font-family: 'Archivo Black', sans-serif; font-size: 1rem; color: #d4af37; line-height: 1; }
    .chip-lbl { font-size: 8px; color: rgba(255,255,255,0.3); text-transform: uppercase; letter-spacing: 0.12em; margin-top: 4px; }

    /* SECTION 3 — feature rows, alternating left/right accent */
    .sec-3 { padding: 10px 24px 0; display: flex; flex-direction: column; gap: 1px; }
    .feat-row-item {
      display: flex; align-items: center; gap: 14px;
      padding: 16px 14px; border-radius: 14px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(212,175,55,0.1);
      transition: all 0.2s;
    }
    .feat-row-item:active { transform: scale(0.98); background: rgba(255,255,255,0.05); }
    .feat-row-item + .feat-row-item { margin-top: 10px; }
    .feat-num {
      font-family: 'Archivo Black', sans-serif;
      font-size: 1.4rem; color: #d4af37;
      line-height: 1; flex-shrink: 0; width: 28px;
    }
    .feat-ico { font-size: 20px; flex-shrink: 0; filter: drop-shadow(0 0 10px rgba(212,175,55,0.3)); }
    .feat-body { flex: 1; min-width: 0; }
    .feat-title { font-size: 14px; font-weight: 600; color: #fff; }
    .feat-desc { font-size: 11px; color: rgba(255,255,255,0.35); margin-top: 2px; }
    .feat-arrow { color: rgba(212,175,55,0.4); font-size: 16px; flex-shrink: 0; }

    /* SECTION 4 — accuracy bars compact */
    .sec-4 {
      margin: 24px 24px 0;
      background: rgba(212,175,55,0.03);
      border: 1px solid rgba(212,175,55,0.1);
      border-radius: 18px; padding: 18px;
    }
    .sec-4-label { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: #d4af37; margin-bottom: 12px; font-weight: 600; }
    .bar-row { display: flex; align-items: center; gap: 10px; }
    .bar-row + .bar-row { margin-top: 10px; }
    .bar-name { font-size: 11px; color: rgba(255,255,255,0.4); width: 30px; flex-shrink: 0; font-weight: 600; letter-spacing: 0.05em; }
    .bar-track { flex: 1; height: 5px; background: rgba(255,255,255,0.05); border-radius: 99px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg, #b8860b, #d4af37, #ffd700); }
    .bar-pct { font-size: 11px; color: #d4af37; font-weight: 800; width: 35px; text-align: right; flex-shrink: 0; }

    .b1{animation:b1 1.5s ease forwards 0.1s;width:0} @keyframes b1{to{width:90%}}
    .b2{animation:b2 1.5s ease forwards 0.22s;width:0} @keyframes b2{to{width:82%}}
    .b3{animation:b3 1.5s ease forwards 0.34s;width:0} @keyframes b3{to{width:88%}}

    /* SECTION 5 — CTA full width */
    .sec-5 { padding: 24px 24px 36px; display: flex; flex-direction: column; gap: 14px; }

    .cta {
      display: flex; align-items: center; justify-content: center; gap: 12px;
      width: 100%; min-height: 58px;
      background: linear-gradient(135deg, #d4af37, #f1c40f, #ffd700);
      color: #000;
      font-family: 'Archivo Black', sans-serif;
      font-size: clamp(0.9rem, 4.5vw, 1.1rem);
      letter-spacing: 0.06em;
      border-radius: 18px; text-decoration: none;
      position: relative; overflow: hidden;
      box-shadow: 0 10px 40px rgba(212,175,55,0.3);
      transition: all .2s; -webkit-tap-highlight-color: transparent;
    }
    .cta svg { flex-shrink: 0; width: 22px; height: 22px; }
    .cta::after {
      content: ''; position: absolute; top:0; left:-100%; width:50%; height:100%;
      background: linear-gradient(90deg,transparent,rgba(255,255,255,0.5),transparent);
      transform: skewX(-18deg); animation: shine 3s ease-in-out infinite;
    }
    @keyframes shine { 0%,65%{left:-100%} 100%{left:160%} }
    .cta:active { transform: scale(0.97); box-shadow: 0 4px 20px rgba(212,175,55,0.2); }

    .ads-link-wrap {
